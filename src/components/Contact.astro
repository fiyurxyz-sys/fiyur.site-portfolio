---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---
<section id="iletisim" class="py-20 sm:py-28 bg-ink text-cream">
  <div class="px-4 sm:px-6 max-w-6xl mx-auto">
    <div data-reveal>
      <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-3">İletişim</p>
      <h2 class="font-heading font-black text-[clamp(2rem,5vw,3.5rem)] leading-tight mb-5 text-cream">
        Konuşalım.
      </h2>
      <p class="font-body text-cream/60 mb-14 max-w-lg text-sm">
        WhatsApp'tan hızlıca yazabilirsin ya da formu doldurabilirsin. En geç 24 saat içinde dönüyorum.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Left: WhatsApp CTA -->
      <div data-reveal class="space-y-6">
        <a
          href="https://wa.me/905452940171"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 border-2 border-cream/20 p-6 hover:border-orange transition-colors duration-150 group focus:outline-none focus:ring-2 focus:ring-orange"
        >
          <span class="w-14 h-14 rounded-full bg-[#25D366] flex items-center justify-center shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="white" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </span>
          <div>
            <p class="font-heading font-bold text-lg text-cream group-hover:text-orange transition-colors">WhatsApp'tan yaz</p>
            <p class="text-cream/50 text-sm font-body">+90 545 294 01 71</p>
          </div>
        </a>

        <!-- E-posta placeholder -->
        <div class="border-2 border-cream/10 p-6 opacity-50">
          <p class="font-heading font-bold text-lg text-cream mb-1">E-posta</p>
          <p class="text-cream/50 text-sm font-body">fiyur.xyz@gmail.com</p>
        </div>
      </div>

      <!-- Right: Form -->
      <div data-reveal>
        <form
          id="contact-form"
          class="space-y-5"
          novalidate
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Fiyur Portfolio - Yeni İletişim Mesajı" />
          <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" />

          <div>
            <label for="name" class="block text-sm font-semibold mb-2 text-cream/80">Adın</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="w-full bg-transparent border-2 border-cream/20 px-4 py-3 text-cream placeholder:text-cream/30 focus:outline-none focus:border-orange transition-colors duration-150 font-body"
              placeholder="Ahmet Yılmaz"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold mb-2 text-cream/80">E-posta Adresin</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full bg-transparent border-2 border-cream/20 px-4 py-3 text-cream placeholder:text-cream/30 focus:outline-none focus:border-orange transition-colors duration-150 font-body"
              placeholder="ornek@posta.com"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold mb-2 text-cream/80">Telefon (isteğe bağlı)</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="w-full bg-transparent border-2 border-cream/20 px-4 py-3 text-cream placeholder:text-cream/30 focus:outline-none focus:border-orange transition-colors duration-150 font-body"
              placeholder="+90 5xx xxx xx xx"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold mb-2 text-cream/80">Ne yapmak istiyorsun?</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full bg-transparent border-2 border-cream/20 px-4 py-3 text-cream placeholder:text-cream/30 focus:outline-none focus:border-orange transition-colors duration-150 font-body resize-y"
              placeholder="Kısaca anlat — hangi işletmedesin, ne ihtiyacın var..."
            ></textarea>
          </div>

          <!-- Submit button + status -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full font-heading font-bold text-base px-6 py-4 bg-orange text-cream border-2 border-orange shadow-hard hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-none transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-orange focus:ring-offset-2 focus:ring-offset-ink disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Gönder
          </button>

          <!-- Status messages -->
          <div id="form-status" role="alert" aria-live="polite" class="hidden">
            <p id="form-success" class="hidden text-sm font-semibold text-[#4ade80] border border-[#4ade80]/30 px-4 py-3">
              ✅ Mesajın iletildi! En geç 24 saat içinde dönüyorum.
            </p>
            <p id="form-error" class="hidden text-sm font-semibold text-red-400 border border-red-400/30 px-4 py-3">
              ⚠️ Bir şeyler ters gitti. WhatsApp'tan yazarsan daha hızlı ulaşırım.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const statusDiv = document.getElementById('form-status');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    // Tarayıcı doğrulaması kontrolü
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Durumları sıfırla
    submitBtn.disabled = true;
    submitBtn.textContent = 'Gönderiliyor...';
    statusDiv?.classList.add('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const formData = new FormData(form);
      const dataObject: Record<string, any> = Object.fromEntries(formData.entries());

      // Eğer formdaki access_key boş veya yer tutucuysa env değişkeninden al
      if (!dataObject.access_key || dataObject.access_key === 'your_web3forms_key_here') {
        dataObject.access_key = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
      }

      if (!dataObject.access_key) {
        throw new Error('Erişim anahtarı (access_key) bulunamadı. Lütfen .env dosyasını kontrol edin.');
      }

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(dataObject),
      });

      const result = await response.json();

      if (result.success) {
        statusDiv?.classList.remove('hidden');
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error(result.message || 'Mesaj gönderilemedi.');
      }
    } catch (err: any) {
      statusDiv?.classList.remove('hidden');
      if (errorMsg) {
        errorMsg.textContent = `⚠️ ${err.message || 'Bir şeyler ters gitti. WhatsApp\'tan yazarsan daha hızlı ulaşırım.'}`;
        errorMsg.classList.remove('hidden');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Gönder';
    }
  });
</script>
