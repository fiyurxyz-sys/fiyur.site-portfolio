---
const works = [
  {
    label: 'Örnek Çalışma',
    title: 'Klinik Randevu Sistemi',
    description: 'Küçük bir klinik için web üzerinden randevu alınabilen, doktor programı yönetilebilen basit bir uygulama.',
    problem: 'Telefon kuyruğu ve manuel takvim hatalarından kaynaklanan zaman kaybı.',
    tech: ['Python', 'FastAPI', 'HTML/CSS/JS'],
    demoUrl: null,
  },
  {
    label: 'Örnek Çalışma',
    title: 'Restoran Sipariş Takip Paneli',
    description: 'Masabaşı siparişlerin mutfağa iletildiği, hazırlanma durumunun anlık takip edilebildiği masaüstü uygulama.',
    problem: 'Kâğıt fişlerin kaybolması ve iletişim karmaşasından doğan hata.',
    tech: ['Python', 'Tkinter', 'SQLite'],
    demoUrl: null,
  },
  {
    label: 'Örnek Çalışma',
    title: 'Ürün Stok ve Fiyat Asistanı',
    description: 'Esnaf için barkod okutarak stok güncellemesi yapılabilen, yapay zeka ile fiyat önerisi sunan hafif bir web aracı.',
    problem: 'Manuel sayım hataları ve fiyatların güncellenmesindeki gecikme.',
    tech: ['Python', 'Gemini API', 'JavaScript'],
    demoUrl: null,
  },
  {
    label: 'Örnek Çalışma',
    title: 'Kuryeler İçin En Verimli Paket Dağıtım Algoritması',
    description: 'bir çok yemek sipariş uygulamasından ve telefon arayıcılığıyla gelen onlarca siparişi tek bir yerde toplayan, dükkandan cıkacak kuryelerin sadece hangi paketleri almasını gerektiğini söyleyen bir local python scripti',
    problem: 'tek kuryeye birden fazla sipariş verilmesi gereken durumlarda manuel rota planlanmasındaki verimsizlik',
    tech: ['Python', 'OSRM', 'OSM', 'JavaScript', 'Next.js'],
    demoUrl: null,
  },
];
---
<section id="calismalari" class="py-20 sm:py-28 px-4 sm:px-6 max-w-6xl mx-auto">
  <div data-reveal>
    <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-3">Çalışmalar</p>
    <h2 class="font-heading font-black text-[clamp(2rem,5vw,3.5rem)] leading-tight mb-4">
      Ne yaptım,<br/>ne çözdüm?
    </h2>
    <p class="text-ink/60 font-body mb-14 max-w-lg text-sm">
      Aşağıdakiler, gerçek kullanım senaryolarına dayalı daha önce yaptığım çalışmalardır. İncele, kendi işletmende yaşadığın bir problem görüyorsan iletişime geçmekten çekinme.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {works.map((w) => (
      <article
        data-reveal
        class="border-2 border-ink shadow-hard bg-cream p-7 flex flex-col hover:translate-x-[5px] hover:translate-y-[5px] hover:shadow-none transition-all duration-150"
      >
        <span class="inline-block text-xs font-bold uppercase tracking-widest bg-blue text-cream px-2 py-1 mb-5 self-start">
          {w.label}
        </span>
        <h3 class="font-heading font-bold text-xl leading-tight mb-3">{w.title}</h3>
        <p class="font-body text-ink/70 text-sm leading-relaxed mb-4">{w.description}</p>
        <div class="bg-ink/5 border-l-4 border-orange px-4 py-3 mb-5">
          <p class="text-xs font-semibold text-ink/50 uppercase tracking-wide mb-1">Problem</p>
          <p class="text-sm text-ink/80">{w.problem}</p>
        </div>
        <div class="flex flex-wrap gap-2 mt-auto">
          {w.tech.map((t) => (
            <span class="text-xs font-semibold border border-ink/30 px-2 py-0.5">{t}</span>
          ))}
        </div>
        {w.demoUrl && (
          <a
            href={w.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center justify-center font-heading font-bold text-sm px-4 py-2 border-2 border-ink shadow-hard-sm hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none transition-all duration-150"
          >
            Canlı demo →
          </a>
        )}
      </article>
    ))}
  </div>
</section>
