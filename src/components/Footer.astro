---
const year = new Date().getFullYear();
---
<footer class="bg-cream border-t-2 border-ink py-10 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm font-body">
    <p class="font-heading font-black text-base">
      Fiyur <span class="text-orange">·</span> Furkan Kılıçarslan
    </p>
    <p class="text-ink/50 text-xs">
      © {year} · Bursa, Türkiye · Tüm hakları saklıdır.
    </p>
    <nav aria-label="Footer menüsü">
      <ul class="flex gap-4 text-ink/60">
        <li><a href="#hizmetler" class="hover:text-orange transition-colors">Hizmetler</a></li>
        <li><a href="#iletisim" class="hover:text-orange transition-colors">İletişim</a></li>
      </ul>
    </nav>
  </div>
</footer>
