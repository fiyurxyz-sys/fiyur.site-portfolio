---
const services = [
  {
    icon: '🖥️',
    title: 'Web Sitesi & Online Varlık',
    description: 'Müşterilerin seni Google\'da bulsun, bilgi alsın, arasın. Hızlı yüklenen, mobil uyumlu, kendi panelinden güncelleyebildiğin bir site.',
    benefit: 'Yeni müşteri kazanımını artırır, 7/24 seni temsil eder.',
  },
  {
    icon: '🗂️',
    title: 'İş Takip & Yönetim Yazılımı',
    description: 'Randevu, stok, sipariş, müşteri kaydı — Excel\'den kurtul, işletmene özel bir sisteme geç. Masa üstünde ya da web\'de çalışır.',
    benefit: 'Zaman kaybını azaltır, insan hatasını minimuma indirir.',
  },
  {
    icon: '🤖',
    title: 'Yapay Zeka Destekli Araçlar',
    description: 'Müşteri sorularına otomatik yanıt, belge özetleme, satış tahmini gibi işleri yapay zeka ile otomatikleştiriyorum — senin süreçlerine uygun şekilde.',
    benefit: 'İnsan gücünü verimli kullanırsın, tekrar eden işler kalkar.',
  },
];
---
<section id="hizmetler" class="py-20 sm:py-28 px-4 sm:px-6 max-w-6xl mx-auto">
  <div data-reveal>
    <p class="text-sm font-semibold uppercase tracking-widest text-orange mb-3">Ne Yapıyorum</p>
    <h2 class="font-heading font-black text-[clamp(2rem,5vw,3.5rem)] leading-tight mb-14">
      İşletmene ne<br/>kazandırır?
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((s, i) => (
      <article
        data-reveal
        class="border-2 border-ink shadow-hard bg-cream p-7 hover:translate-x-[5px] hover:translate-y-[5px] hover:shadow-none transition-all duration-150 cursor-default"
      >
        <div class="text-4xl mb-5" aria-hidden="true">{s.icon}</div>
        <h3 class="font-heading font-bold text-xl leading-tight mb-3">{s.title}</h3>
        <p class="font-body text-ink/70 leading-relaxed mb-5 text-sm">{s.description}</p>
        <div class="border-t-2 border-ink/10 pt-4">
          <p class="text-xs font-semibold text-orange uppercase tracking-wide">✓ {s.benefit}</p>
        </div>
      </article>
    ))}
  </div>
</section>
